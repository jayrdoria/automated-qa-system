generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One row per check execution. The runner POSTs these after every cron run.
model CheckRun {
  id         String   @id @default(cuid())
  brand      String // "stakes" | "x7"
  /// Market this run represents (FR/DE/IT/ES) — decided by the VPN exit node.
  region     String   @default("FR")
  checkName  String   @map("check_name") // "login" | "game-load" | "providers" | ...
  status     String // "pass" | "fail"
  durationMs Int      @map("duration_ms")
  error      String?
  /// Path inside the artifacts volume. Never served publicly unless
  /// PUBLIC_SHOW_SCREENSHOTS is enabled — these contain logged-in account state.
  screenshot String?
  startedAt  DateTime @map("started_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([brand, region, checkName, startedAt])
  @@index([startedAt])
  @@map("check_run")
}

/// Current known status per check, driving alert dedup so a broken check
/// doesn't email the Slack channel every 20 minutes overnight.
model CheckState {
  id             String    @id @default(cuid())
  brand          String
  region         String    @default("FR")
  checkName      String    @map("check_name")
  status         String
  since          DateTime
  lastNotifiedAt DateTime? @map("last_notified_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([brand, region, checkName])
  @@map("check_state")
}

/// Live progress of the currently-executing run, one row per brand+region.
///
/// Deliberately separate from CheckRun: that table is durable history and drives
/// alerting, so it is written once at the end of a run as a single batch. This
/// table is volatile UI state written on every test — mixing them would mean
/// alert logic firing per-test and partial runs polluting history.
model RunProgress {
  id         String    @id @default(cuid())
  brand      String
  region     String
  total      Int
  completed  Int       @default(0)
  passed     Int       @default(0)
  failed     Int       @default(0)
  /// The check executing right now. Lets each row show queued → running → result
  /// instead of the whole grid blanking behind one aggregate percentage.
  currentCheck String? @map("current_check")
  /// When the current check started — lets the UI show elapsed time against
  /// that check's historical median instead of an invented percentage.
  currentStartedAt DateTime? @map("current_started_at")
  /// Per-check outcomes for THIS run: { "login": "pass", "game-load": "fail" }.
  /// Without it a finished check has nowhere to live until the end-of-run batch
  /// writes check_run, so every completed row would sit on "Queued" and the
  /// whole column would flip to Pass at once instead of draining row by row.
  results      Json?
  startedAt  DateTime  @map("started_at")
  finishedAt DateTime? @map("finished_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([brand, region])
  @@map("run_progress")
}
