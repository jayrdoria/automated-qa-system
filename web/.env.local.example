# Local development only. Copy to web/.env.local (gitignored).
# Next.js loads this automatically for `npm run dev`.
#
# Port 5433 matches docker-compose.yml (the dev Postgres), NOT 5432.
DATABASE_URL=postgresql://qa:CHANGE_ME@localhost:5433/qa_monitor

# Any 32+ char string locally. Must match what the runner sends (the root .env).
#
# Include the marker "local_dev" somewhere in the value. The deploy guard in
# .github/workflows/deploy.yml aborts if it finds that marker in the SERVER
# .env, which is what stops a local file from being uploaded over the
# production one. Leaving it out disables that protection.
#
# Deliberately NOT a ready-to-paste value: a usable placeholder gets copied
# verbatim into real .env files, which is how a dev token reached production
# once already.
INGEST_TOKEN=CHANGE_ME_local_dev_<32-plus-characters>

PUBLIC_SHOW_SCREENSHOTS=false
