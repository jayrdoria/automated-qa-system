# ─── Database ───────────────────────────────────────────────────────
# Consumed by both the postgres container and the web app.
# DATABASE_URL is assembled from these in docker-compose.prod.yml — do not set it here.
POSTGRES_USER=qa
POSTGRES_PASSWORD=
POSTGRES_DB=qa_monitor

# ─── Runner → web ingest ────────────────────────────────────────────
# Shared secret for POST /automated-qa-system/api/results.
# That route is publicly reachable through Apache, so this is the only thing
# stopping anyone from writing fake check results.
# Generate with: openssl rand -hex 32
INGEST_TOKEN=

# ─── Dashboard ──────────────────────────────────────────────────────
# Failure screenshots capture logged-in casino account state and the dashboard
# is unauthenticated. Leave false unless you've added auth.
PUBLIC_SHOW_SCREENSHOTS=false

# ─── Brand test accounts ────────────────────────────────────────────
# Real values live ONLY in .env on the VPS. Never commit them.
STAKES_BASE_URL=
STAKES_USERNAME=
STAKES_PASSWORD=

X7_BASE_URL=
X7_USERNAME=
X7_PASSWORD=

# ─── Gmail SMTP (app password, not the account password) ────────────
# Same pattern as leave-management-system/utils/mailer.js — port 587, STARTTLS
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# Slack channel email-to-channel address that failures are sent to
ALERT_TO=

# ─── Alerting behaviour ─────────────────────────────────────────────
# Hours to wait before re-notifying about a check that is still failing
ALERT_RENOTIFY_HOURS=4

# ─── Runner → web ingest URL ────────────────────────────────────────
# Production: compose sets this to the in-network URL, leave blank here.
# Local dev:  http://localhost:3000/automated-qa-system/api/results
INGEST_URL=

# ─── ProtonVPN (only if docker-compose.vpn.yml is used) ─────────────
# OpenVPN credentials from account.protonvpn.com → Account → OpenVPN/IKEv2.
# NOT your Proton account login. Also place a France .ovpn at vpn/fr.ovpn
PROTON_OPENVPN_USER=
PROTON_OPENVPN_PASS=
