{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  // No `paths` mapping on purpose. Playwright's built-in transpiler does not
  // resolve tsconfig path aliases, so an alias would typecheck here and then
  // fail at runtime inside the container. Specs use relative imports.
  "include": [
    "tests/**/*.ts",
    "lib/**/*.ts",
    "reporter/**/*.ts",
    "playwright.config.ts"
  ]
}
